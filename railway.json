{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx prisma generate && npm run build"
  },
  "deploy": {
    "startCommand": "npm run start",
    "preDeployCommand": [
      "npx prisma db push --accept-data-loss",
      "npx prisma db seed"
    ],
    "healthcheckPath": "/"
  }
}
